generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Server {
  id         Int             @id @default(autoincrement())
  username   String          @unique
  password   String
  name       String
  type       String
  location   String
  region     String
  disabled   Boolean         @default(false)
  // https://github.com/prisma/prisma/issues/8510
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  histories  ServerHistory[]

  @@map("servers")
}

model ServerHistory {
  id           Int      @id @default(autoincrement())
  server_id    Int
  created_at   DateTime @default(now())
  cpu          Float
  memory_used  Float
  memory_total Float
  network_in   Float
  network_out  Float
  network_rx   Float
  network_tx   Float
  server       Server   @relation(fields: [server_id], references: [id], onDelete: Cascade)

  @@index([server_id, created_at])
  @@map("server_histories")
}

model Option {
  id    Int    @id @default(autoincrement())
  name  String @unique
  value String

  @@map("options")
}

model Event {
  id         Int      @id @default(autoincrement())
  username   String
  resolved   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("events")
}
